num1= int(input("Escriu un numero: "))
num2= int(input("Escriu un altre numero: "))

print("vols sumar, restar, multiplicar, dividir, elevar a la potencia, fer el modul o fer la divisio entera?")
operacio=input("Escriu la operacio que vols fer: ")

if operacio=="sumar":
    resultat=num1+num2
    print(f"El resultat de la suma entre {num1} i {num2} és: {resultat}")
elif operacio=="restar":
    escollir=input("Vols restar num1-num2 o num2-num1? (1/2): ")
    if escollir=="1":
        resultat=num1-num2
        print(f"El resultat de la resta entre {num1} i {num2} és: {resultat}")
    else:
        resultat=num2-num1
        print(f"El resultat de la resta entre {num2} i {num1} és: {resultat}")
elif operacio=="multiplicar":
    resultat=num1*num2
    print(f"El resultat de la multiplicació entre {num1} i {num2} és: {resultat}")
elif operacio=="dividir":
    escollir=input("Vols dividir num1 entre num2 o num2 entre num1? (1/2): ")
    if escollir=="1":
        resultat=num1/num2
        print(f"El resultat de la divisió entre {num1} i {num2} és: {resultat}")
    else:
        resultat=num2/num1
        print(f"El resultat de la divisió entre {num2} i {num1} és: {resultat}")
elif operacio=="elevar a la potencia":
    escollir=input("Vols elevar num1 a num2 o num2 a num1? (1/2): ")
    if escollir=="1":
        resultat=num1**num2
        print(f"El resultat de l'elevació entre {num1} i {num2} és: {resultat}")
    else:
        resultat=num2**num1
        print(f"El resultat de l'elevació entre {num2} i {num1} és: {resultat}")
elif operacio=="fer el modul":
    escollir=input("Vols fer el modul de num1 entre num2 o num2 entre num1? (1/2): ")
    if escollir=="1":
        resultat=num1%num2
        print(f"El resultat del mòdul entre {num1} i {num2} és: {resultat}")
    else:
        resultat=num2%num1
        print(f"El resultat del mòdul entre {num2} i {num1} és: {resultat}")
elif operacio=="fer la divisio entera":
    escollir=input("Vols fer la divisio entera de num1 entre num2 o num2 entre num1? (1/2): ")
    if escollir=="1":
        resultat=num1//num2
        print(f"El resultat de la divisió entera entre {num1} i {num2} és: {resultat}")
    else:
        resultat=num2//num1
        print(f"El resultat de la divisió entera de {num2} entre {num1} és: {resultat}")