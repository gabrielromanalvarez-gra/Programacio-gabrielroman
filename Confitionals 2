num1= int(input("Escriu un numero: "))
num2= int(input("Escriu un altre numero: "))

print("vols sumar, restar, multiplicar, dividir, elevar a la potencia, fer el modul o fer la divisio entera?")
operacio=input("Escriu la operacio que vols fer: ")

if operacio=="sumar":
    print(num1+num2)
elif operacio=="restar":
    escollir=input("Vols restar el primer numero pel segon o el segon pel primer? (1/2): ")
    if escollir=="1":
        print(num1-num2)
    else:
        print(num2-num1)
elif operacio=="multiplicar":
    print(num1*num2)
elif operacio=="dividir":
    escollir=input("Vols dividir el primer numero pel segon o el segon pel primer? (1/2): ")
    if escollir=="1":
        print(num1/num2)
    else:
        print(num2/num1)
elif operacio=="elevar a la potencia":
    escollir=input("Vols elevar el primer numero al segon o el segon al primer? (1/2): ")
    if escollir=="1":
        print(num1**num2)
    else:
        print(num2**num1)
elif operacio=="fer el modul":
    escollir=input("Vols fer el modul del primer numero pel segon o el segon pel primer? (1/2): ")
    if escollir=="1":
        print(num1%num2)
    else:
        print(num2%num1)
elif operacio=="fer la divisio entera":
    escollir=input("Vols fer la divisio entera del primer numero pel segon o el segon pel primer? (1/2): ")
    if escollir=="1":
        print(num1//num2)
    else:
        print(num2//num1)